# Recall local configuration. Values are literal, not shell-expanded.
# Copy to .env for local use. Do not commit passwords.
RECALL_BIND=127.0.0.1:6379
# RECALL_WORKERS=4
RECALL_IO_THREADS=2
RECALL_MAX_MEMORY_MIB=256
RECALL_KEYS_PER_WORKER=16384
RECALL_MAX_CONNECTIONS=32
RECALL_QUEUE_BYTES_MIB=4
# Authentication is disabled when RECALL_PASSWORD is absent.
# Add RECALL_PASSWORD with a private, nonempty value when required.
